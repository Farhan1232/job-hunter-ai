# Copy this to .env and fill in your free API keys.
# All keys below are free — no credit card needed.

# Discord webhook (preferred — works in Pakistan, simpler).
# Get it from: Discord → any server → channel settings → Integrations → Webhooks → New
DISCORD_WEBHOOK_URL=

# Telegram bot — alternative. Note: api.telegram.org is blocked from some
# networks (e.g. Pakistan). Works fine from GitHub Actions. Get token from
# @BotFather and chat ID from @userinfobot on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini API — free at https://aistudio.google.com/apikey (~20 req/day on flash)
GEMINI_API_KEY=

# Groq API — free at https://console.groq.com (~6000 req/day on Llama 3.3 70B)
# Used as fallback when Gemini's daily quota runs out.
GROQ_API_KEY=

# Adzuna — free at https://developer.adzuna.com (250 calls/day)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — free at https://jooble.org/api/about
JOOBLE_API_KEY=
